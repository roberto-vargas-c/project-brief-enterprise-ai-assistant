# Copy to .env and fill in
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# IRONSTORE_CHAT_MODEL=gpt-6-luna
# IRONSTORE_EMBEDDINGS=openai            # openai | huggingface | tfidf
# IRONSTORE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# IRONSTORE_TOP_K=6
# IRONSTORE_TEMPERATURE=                 # leave unset to use the model's default

# Evaluation (python -m ironstore_assistant.evaluate)
# IRONSTORE_JUDGE_MODEL=gpt-6-luna        # LLM-as-judge; ideally a different, stronger model
# IRONSTORE_PRICE_INPUT_PER_M=           # price per million input tokens, for the cost column
# IRONSTORE_PRICE_OUTPUT_PER_M=          # price per million output tokens
# LANGSMITH_API_KEY=                     # optional: trace evaluation runs to LangSmith
